<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:OpenTaskbar.Views"
                    xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Style x:Key="DockResizeThumb" TargetType="Thumb">
        <Setter Property="Width" Value="{StaticResource DockResizeGripWidth}" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Width="{TemplateBinding Width}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border x:Name="GripIndicator" Width="3" Height="14" CornerRadius="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource IndicatorBrush}" Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="GripScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GripIndicator" Property="Opacity" Value="0.65" />
                            <Setter TargetName="GripIndicator" Property="Height" Value="20" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="GripIndicator" Property="Opacity" Value="1.0" />
                            <Setter TargetName="GripIndicator" Property="Height" Value="28" />
                            <Setter TargetName="GripIndicator" Property="Width" Value="4" />
                            <Setter TargetName="GripIndicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Tile look: each dock item is a rounded tile (DockTile) inset 3 DIP inside its cell, so 50 DIP cells give
         44 DIP tiles with 6 DIP gaps. Running apps get a small blue dot inside the tile; the foreground app a capsule. -->
    <Style x:Key="DockButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource DockTile}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="{DynamicResource DockCellSize}" />
        <Setter Property="Height" Value="{DynamicResource DockCellHeight}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.95" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Surface" Margin="{DynamicResource DockTileInset}" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource DockTileStroke}" BorderThickness="{StaticResource ControlStroke}"
                                CornerRadius="{StaticResource DockTileRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle x:Name="ActiveIndicator" Height="{DynamicResource RunningIndicatorHeight}" Width="{DynamicResource RunningIndicatorWidth}" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource RunningDotBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                           HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DockTileHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource StrokeFocus}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsForeground}" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceSelectedStrong}" />
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ActiveIndicator" Property="Width" Value="{DynamicResource RunningIndicatorActiveWidth}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Start button: the same tile with the four-square Windows logo. -->
    <Style x:Key="StartDockButton" TargetType="Button" BasedOn="{StaticResource DockButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border x:Name="StartTile" Margin="{DynamicResource DockTileInset}" CornerRadius="{StaticResource DockTileRadius}"
                                Background="{DynamicResource StartTileBackground}" BorderBrush="{DynamicResource DockTileStroke}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StartTile" Property="Background" Value="{DynamicResource DockTileHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StartTile" Property="Background" Value="{DynamicResource SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="StartTile" Property="BorderBrush" Value="{DynamicResource StrokeFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DockScrollViewerStyle" TargetType="{x:Type views:DockScrollViewer}">
        <Setter Property="AutomationProperties.HelpText" Value="{local:Loc ScrollDockHelp}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="PanningMode" Value="HorizontalOnly" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:DockScrollViewer}">
                    <Grid>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="False">
                            <ScrollContentPresenter.Content>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}" />
                            </ScrollContentPresenter.Content>
                        </ScrollContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
